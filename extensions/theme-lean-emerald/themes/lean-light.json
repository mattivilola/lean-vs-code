{
  "$schema": "vscode://schemas/color-theme",
  "name": "Lean VS Code Light",
  "colors": {
    "foreground": "#203A2D",
    "focusBorder": "#167347",
    "contrastBorder": "#00000000",
    "editor.background": "#FFFFFF",
    "editor.foreground": "#203A2D",
    "editorCursor.foreground": "#126B43",
    "editor.lineHighlightBackground": "#F2F8F3",
    "editor.selectionBackground": "#BFE8CE",
    "editor.inactiveSelectionBackground": "#DCEFE2",
    "editor.selectionHighlightBackground": "#A6DBBA66",
    "editor.findMatchBackground": "#A9DDB5",
    "editor.findMatchHighlightBackground": "#C8E8D1",
    "editorLineNumber.foreground": "#607B6B",
    "editorLineNumber.activeForeground": "#24583B",
    "editorIndentGuide.background1": "#D9E9DE",
    "editorIndentGuide.activeBackground1": "#84B69A",
    "editorWhitespace.foreground": "#BDD4C4",
    "editorGutter.addedBackground": "#23865B",
    "editorGutter.modifiedBackground": "#8A6C20",
    "editorGutter.deletedBackground": "#B44F43",
    "diffEditor.insertedTextBackground": "#B8E4C380",
    "diffEditor.removedTextBackground": "#F3C9C280",
    "diffEditor.insertedLineBackground": "#E2F4E680",
    "diffEditor.removedLineBackground": "#FCE9E680",
    "activityBar.background": "#EAF3EC",
    "activityBar.foreground": "#203A2D",
    "activityBar.inactiveForeground": "#5A7462",
    "activityBar.activeBorder": "#167347",
    "activityBarBadge.background": "#126B43",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#F3F8F4",
    "sideBar.foreground": "#294535",
    "sideBar.border": "#D3E4D7",
    "sideBarTitle.foreground": "#203A2D",
    "sideBarSectionHeader.background": "#EAF3EC",
    "sideBarSectionHeader.foreground": "#294535",
    "list.activeSelectionBackground": "#CDEBD5",
    "list.activeSelectionForeground": "#183D29",
    "list.hoverBackground": "#E5F2E8",
    "list.inactiveSelectionBackground": "#E0EFE4",
    "statusBar.background": "#DCEDE1",
    "statusBar.foreground": "#1F4B33",
    "statusBar.noFolderBackground": "#DCEDE1",
    "statusBar.debuggingBackground": "#C4E5CE",
    "statusBar.debuggingForeground": "#1F4B33",
    "titleBar.activeBackground": "#EAF3EC",
    "titleBar.activeForeground": "#203A2D",
    "titleBar.inactiveBackground": "#F3F8F4",
    "titleBar.inactiveForeground": "#5A7462",
    "tab.activeBackground": "#FFFFFF",
    "tab.activeForeground": "#203A2D",
    "tab.inactiveBackground": "#EAF3EC",
    "tab.inactiveForeground": "#5A7462",
    "tab.activeBorderTop": "#167347",
    "editorGroupHeader.tabsBackground": "#EAF3EC",
    "panel.background": "#F7FAF7",
    "panel.border": "#D3E4D7",
    "terminal.background": "#FFFFFF",
    "terminal.foreground": "#203A2D",
    "terminalCursor.foreground": "#126B43",
    "input.background": "#FFFFFF",
    "input.foreground": "#203A2D",
    "input.border": "#A8C5B0",
    "input.placeholderForeground": "#5A7462",
    "dropdown.background": "#FFFFFF",
    "dropdown.foreground": "#203A2D",
    "dropdown.border": "#A8C5B0",
    "button.background": "#126B43",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#0C5836",
    "button.secondaryBackground": "#DCEDE1",
    "button.secondaryForeground": "#1F4B33",
    "button.secondaryHoverBackground": "#CDE5D4",
    "badge.background": "#D4E9DA",
    "badge.foreground": "#1F4B33",
    "notificationCenterHeader.background": "#EAF3EC",
    "notifications.background": "#FFFFFF",
    "notifications.foreground": "#203A2D",
    "notifications.border": "#D3E4D7",
    "quickInput.background": "#F3F8F4",
    "quickInput.foreground": "#203A2D",
    "editorSuggestWidget.background": "#FFFFFF",
    "editorWidget.background": "#FFFFFF",
    "peekViewEditor.background": "#F7FAF7",
    "peekViewResult.background": "#F3F8F4",
    "scrollbarSlider.background": "#6B9D7A33",
    "scrollbarSlider.hoverBackground": "#6B9D7A66",
    "scrollbarSlider.activeBackground": "#6B9D7A88"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#587765", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#326528" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#815516" } },
    { "scope": "constant.language", "settings": { "foreground": "#805126" } },
    { "scope": "keyword", "settings": { "foreground": "#086A45" } },
    { "scope": "storage.type", "settings": { "foreground": "#086A45" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#265F47" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#225E69" } },
    { "scope": "entity.name.class", "settings": { "foreground": "#225E69" } },
    { "scope": "variable.parameter", "settings": { "foreground": "#394D3F" } },
    { "scope": "punctuation", "settings": { "foreground": "#506557" } },
    { "scope": "invalid", "settings": { "foreground": "#8B261D", "background": "#FBE0DB" } }
  ]
}
