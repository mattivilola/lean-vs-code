{
  "$schema": "vscode://schemas/color-theme",
  "name": "Lean Emerald",
  "colors": {
    "foreground": "#D5E9DC",
    "focusBorder": "#53DFA0",
    "contrastBorder": "#00000000",
    "editor.background": "#071A14",
    "editor.foreground": "#D5E9DC",
    "editorCursor.foreground": "#78F7AE",
    "editor.lineHighlightBackground": "#0D271D",
    "editor.selectionBackground": "#18543D",
    "editor.inactiveSelectionBackground": "#123F30",
    "editor.selectionHighlightBackground": "#2F8B6333",
    "editor.findMatchBackground": "#2C9C6580",
    "editor.findMatchHighlightBackground": "#2C9C653B",
    "editorLineNumber.foreground": "#527665",
    "editorLineNumber.activeForeground": "#A8D0B7",
    "editorIndentGuide.background1": "#1C3C2C",
    "editorIndentGuide.activeBackground1": "#417B58",
    "editorWhitespace.foreground": "#2E5640",
    "editorGutter.addedBackground": "#53DFA0",
    "editorGutter.modifiedBackground": "#B9D783",
    "editorGutter.deletedBackground": "#D18472",
    "diffEditor.insertedTextBackground": "#1A643E66",
    "diffEditor.removedTextBackground": "#733E3666",
    "diffEditor.insertedLineBackground": "#123C2980",
    "diffEditor.removedLineBackground": "#4B2A2A80",
    "activityBar.background": "#0B2119",
    "activityBar.foreground": "#D5E9DC",
    "activityBar.inactiveForeground": "#779786",
    "activityBar.activeBorder": "#53DFA0",
    "activityBarBadge.background": "#2D9C68",
    "activityBarBadge.foreground": "#F0FFF3",
    "sideBar.background": "#0B2119",
    "sideBar.foreground": "#BDD8C6",
    "sideBar.border": "#1A3929",
    "sideBarTitle.foreground": "#D5E9DC",
    "sideBarSectionHeader.background": "#102B1F",
    "sideBarSectionHeader.foreground": "#BDD8C6",
    "list.activeSelectionBackground": "#1B523A",
    "list.activeSelectionForeground": "#ECFFF1",
    "list.hoverBackground": "#153626",
    "list.inactiveSelectionBackground": "#173B2B",
    "statusBar.background": "#0D3826",
    "statusBar.foreground": "#D8F3DE",
    "statusBar.noFolderBackground": "#0D3826",
    "statusBar.debuggingBackground": "#22583B",
    "titleBar.activeBackground": "#0B2119",
    "titleBar.activeForeground": "#D5E9DC",
    "titleBar.inactiveBackground": "#0B2119",
    "titleBar.inactiveForeground": "#8CAA97",
    "tab.activeBackground": "#071A14",
    "tab.activeForeground": "#E3F8E8",
    "tab.inactiveBackground": "#10271C",
    "tab.inactiveForeground": "#8CAA97",
    "tab.activeBorderTop": "#53DFA0",
    "editorGroupHeader.tabsBackground": "#0B2119",
    "panel.background": "#0A2018",
    "panel.border": "#1C4630",
    "terminal.background": "#071A14",
    "terminal.foreground": "#D5E9DC",
    "terminalCursor.foreground": "#78F7AE",
    "input.background": "#10291E",
    "input.foreground": "#D5E9DC",
    "input.border": "#2D5D42",
    "input.placeholderForeground": "#789884",
    "dropdown.background": "#10291E",
    "dropdown.foreground": "#D5E9DC",
    "dropdown.border": "#2D5D42",
    "button.background": "#23865B",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#2BA66F",
    "button.secondaryBackground": "#1D4632",
    "button.secondaryForeground": "#D5E9DC",
    "badge.background": "#28543D",
    "badge.foreground": "#E3F8E8",
    "notificationCenterHeader.background": "#10291E",
    "notifications.background": "#10291E",
    "notifications.foreground": "#D5E9DC",
    "peekViewEditor.background": "#0B2119",
    "peekViewResult.background": "#0F2A1E",
    "scrollbarSlider.background": "#74B98A33",
    "scrollbarSlider.hoverBackground": "#74B98A66",
    "scrollbarSlider.activeBackground": "#74B98A88"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#729985", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#B8DDA3" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#E3C68C" } },
    { "scope": "constant.language", "settings": { "foreground": "#D7BA8C" } },
    { "scope": "keyword", "settings": { "foreground": "#75DCAA" } },
    { "scope": "storage.type", "settings": { "foreground": "#75DCAA" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#CFE9B9" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#9BD0BB" } },
    { "scope": "entity.name.class", "settings": { "foreground": "#9BD0BB" } },
    { "scope": "variable.parameter", "settings": { "foreground": "#D9EBD7" } },
    { "scope": "punctuation", "settings": { "foreground": "#A9C5B0" } },
    { "scope": "invalid", "settings": { "foreground": "#FFD7CE", "background": "#733E36" } }
  ]
}
